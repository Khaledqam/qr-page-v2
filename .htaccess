# =========================================================
# AtoZ Store — Root .htaccess  (v3 — refactored)
# =========================================================

RewriteEngine On

# --- Force HTTPS ---
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Admin panel: /AdmN  →  dmn/dmn.php ---
RewriteRule ^AdmN/?$ dmn/dmn.php [L]
# Alias so admin JS/CSS are addressable at /admin/*
RewriteRule ^admin/(.+)$ dmn/$1 [L]

# --- Disable directory listing ---
Options -Indexes

# --- Hide dotfiles ---
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # CSP: tighten in production
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://www.google.com https://s2.googleusercontent.com; connect-src 'self';"
</IfModule>

# --- Static asset caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png  "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType text/css   "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>
